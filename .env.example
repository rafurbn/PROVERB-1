# Google Sheets Apps Script Web App URL (Recommended persistent cloud store)
GOOGLE_SHEET_API_URL=""

# Dashboard access key. REQUIRED in production (NODE_ENV=production).
# The dashboard asks for this once and sends it as the X-App-Secret header.
APP_SECRET=""

# Meta Facebook Page Reels API Credentials
# The token is read ONLY from this env file — it is never written to disk by the app.
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""

# Runtime
PORT="3000"
# Set to "production" when deploying publicly (then APP_SECRET is mandatory)
NODE_ENV="development"

# Optional ElevenLabs Fallback TTS Credentials
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Optional External Cron Webhook Secret (if hosting web server with cron-job.org)
CRON_SECRET=""

# Optional Schedule Settings
DAILY_CRON_SCHEDULE="0 9 * * *"
CRON_TIMEZONE="Asia/Dhaka"
